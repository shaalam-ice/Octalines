@page "{id:guid}"
@model Octalines.Web.Pages.Items.EditItemModel
@{
    ViewData["Title"] = "Edit Item";
}
<div class="card" style="max-width:720px">
    <div class="card-header fw-semibold">Edit Item</div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Name <span class="text-danger">*</span></label>
                    <input asp-for="Input.Name" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Type</label>
                    <select asp-for="Input.ItemType" class="form-select" asp-items="Html.GetEnumSelectList<ItemType>()"></select>
                </div>
                <div class="col-md-4"><label class="form-label">Barcode</label><input asp-for="Input.Barcode" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">SKU</label><input asp-for="Input.Sku" class="form-control" /></div>
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <select asp-for="Input.CategoryId" class="form-select">
                        <option value="">-- None --</option>
                        @foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
                <div class="col-md-4"><label class="form-label">Cost Price</label><input asp-for="Input.CostPrice" class="form-control" type="number" step="0.01" /></div>
                <div class="col-md-4"><label class="form-label">Sale Price</label><input asp-for="Input.SalePrice" class="form-control" type="number" step="0.01" /></div>
                <div class="col-md-4"><label class="form-label">Alert Quantity</label><input asp-for="Input.AlertQuantity" class="form-control" type="number" step="0.01" /></div>
                <div class="col-12"><div class="form-check"><input asp-for="Input.IsActive" class="form-check-input" type="checkbox" /><label asp-for="Input.IsActive" class="form-check-label">Active</label></div></div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Update Item</button>
                <a href="/Items" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
