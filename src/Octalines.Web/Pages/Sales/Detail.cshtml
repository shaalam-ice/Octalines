@page "{id:guid}"
@model Octalines.Web.Pages.Sales.DetailModel
@{
    ViewData["Title"] = "Sale Detail";
}
@if (Model.Sale != null)
{
    <div class="row g-3">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Invoice: @Model.Sale.InvoiceNumber</span>
                    <span class="badge @(Model.Sale.Status == SaleStatus.Completed ? "bg-success" : "bg-danger")">@Model.Sale.Status</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6"><small class="text-muted">Date:</small><div>@Model.Sale.InvoiceDate.ToString("dd MMM yyyy")</div></div>
                        <div class="col-md-6"><small class="text-muted">Customer:</small><div>@(Model.Sale.CustomerName ?? "Walk-in")</div></div>
                    </div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header fw-semibold">Items</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Item</th><th class="text-center">Qty</th><th class="text-end">Price</th><th class="text-end">Discount</th><th class="text-end">Total</th></tr></thead>
                        <tbody>
                            @foreach (var line in Model.Sale.Lines)
                            {
                                <tr>
                                    <td>@line.ItemName</td>
                                    <td class="text-center">@line.Quantity</td>
                                    <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                                    <td class="text-end">@line.DiscountAmount.ToString("N2")</td>
                                    <td class="text-end fw-bold">@line.LineTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card">
                <div class="card-header fw-semibold">Payments</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Method</th><th>Date</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                            @foreach (var pay in Model.Sale.Payments)
                            {
                                <tr><td>@pay.PaymentMethod</td><td>@pay.PaymentDate.ToString("dd MMM yy")</td><td class="text-end">@pay.Amount.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header fw-semibold">Summary</div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-1"><span>Subtotal:</span><span>@Model.Sale.SubTotal.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between mb-1"><span>Discount:</span><span>@Model.Sale.DiscountAmount.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between mb-1"><span>Tax:</span><span>@Model.Sale.TaxAmount.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between fw-bold border-top pt-2 mb-1"><span>Grand Total:</span><span>@Model.Sale.GrandTotal.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between text-success mb-1"><span>Paid:</span><span>@Model.Sale.PaidAmount.ToString("N2")</span></div>
                    <div class="d-flex justify-content-between @(Model.Sale.DueAmount > 0 ? "text-danger fw-bold" : "")"><span>Due:</span><span>@Model.Sale.DueAmount.ToString("N2")</span></div>
                </div>
            </div>
            <div class="mt-3 d-flex flex-column gap-2">
                <button class="btn btn-outline-primary" onclick="window.print()"><i class="fas fa-print me-1"></i>Print Receipt</button>
                <a href="/Sales" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to Sales</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Sale not found.</div>
}
