@page
@model Octalines.Web.Pages.PurchasesModel
@{
    ViewData["Title"] = "Purchases";
}
<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <input name="filter" type="text" class="form-control form-control-sm" placeholder="PO#..." value="@Model.Filter" style="width:180px" />
        <button type="submit" class="btn btn-sm btn-outline-primary">Search</button>
    </form>
    <a href="/Purchases/Create" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>New Purchase</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>PO#</th><th>Date</th><th>Supplier</th><th>Total</th><th>Paid</th><th>Due</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Purchases?.Items ?? Array.Empty<PurchaseDto>())
                {
                    <tr>
                        <td class="fw-semibold">@p.PurchaseNumber</td>
                        <td>@p.PurchaseDate.ToString("dd MMM yy")</td>
                        <td>@(p.SupplierName ?? "—")</td>
                        <td>@p.GrandTotal.ToString("N2")</td>
                        <td>@p.PaidAmount.ToString("N2")</td>
                        <td class="@(p.DueAmount > 0 ? "text-danger fw-bold" : "")">@p.DueAmount.ToString("N2")</td>
                        <td><span class="badge bg-success">@p.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
