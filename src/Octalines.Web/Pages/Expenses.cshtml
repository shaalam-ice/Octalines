@page
@model Octalines.Web.Pages.ExpensesModel
@{
    ViewData["Title"] = "Expenses";
}
<div class="d-flex justify-content-end mb-3">
    <a href="/Expenses/Create" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>Add Expense</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Date</th><th>Category</th><th>Description</th><th class="text-end">Amount</th><th>Account</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Expenses?.Items ?? Array.Empty<ExpenseDto>())
                {
                    <tr>
                        <td>@e.ExpenseDate.ToString("dd MMM yy")</td>
                        <td>@e.CategoryName</td>
                        <td>@e.Description</td>
                        <td class="text-end fw-bold">@e.Amount.ToString("N2")</td>
                        <td>@e.AccountName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
