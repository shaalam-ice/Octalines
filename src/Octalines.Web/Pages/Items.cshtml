@page
@model Octalines.Web.Pages.ItemsModel
@{
    ViewData["Title"] = "Items";
}
<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <input name="filter" type="text" class="form-control form-control-sm" placeholder="Search name/barcode..." value="@Model.Filter" style="width:240px" />
        <button type="submit" class="btn btn-sm btn-outline-primary">Search</button>
    </form>
    <div class="d-flex gap-2">
        <a href="/Items/Create" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>Add Item</a>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Barcode</th><th>Category</th><th>Cost</th><th>Sale Price</th><th>Stock</th><th>Type</th><th style="width:90px"></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items?.Items ?? Array.Empty<ItemDto>())
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td><code class="small">@item.Barcode</code></td>
                        <td>@item.CategoryName</td>
                        <td>@item.CostPrice.ToString("N2")</td>
                        <td class="fw-semibold">@item.SalePrice.ToString("N2")</td>
                        <td>
                            @if (item.ItemType == ItemType.Product)
                            {
                                <span class="@(item.StockQuantity <= item.AlertQuantity ? "text-danger fw-bold" : "")">@item.StockQuantity</span>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td><span class="badge @(item.ItemType == ItemType.Product ? "bg-primary" : "bg-info")">@item.ItemType</span></td>
                        <td><a href="/Items/Edit/@item.Id" class="btn btn-sm btn-outline-secondary py-0 px-2">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if ((Model.Items?.TotalCount ?? 0) > 0)
{
    <div class="mt-2 text-muted small">Showing @(Model.Items?.Items.Count ?? 0) of @Model.Items?.TotalCount items</div>
}
