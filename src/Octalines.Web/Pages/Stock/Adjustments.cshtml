@page
@model Octalines.Web.Pages.Stock.AdjustmentsModel
@{
    ViewData["Title"] = "Stock Adjustments";
}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" href="/Stock/Adjustments">Adjustments</a></li>
    <li class="nav-item"><a class="nav-link" href="/Stock/Transfers">Transfers</a></li>
</ul>
<div class="d-flex justify-content-end mb-3">
    <a href="/Stock/Adjustments/Create" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>New Adjustment</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Date</th><th>Item</th><th>Warehouse</th><th>Type</th><th class="text-center">Qty</th><th>Notes</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Adjustments?.Items ?? Array.Empty<StockAdjustmentDto>())
                {
                    <tr>
                        <td>@a.AdjustmentDate.ToString("dd MMM yy")</td>
                        <td>@a.ItemName</td>
                        <td>@a.WarehouseName</td>
                        <td><span class="badge @(a.AdjustmentType == AdjustmentType.Increase ? "bg-success" : "bg-danger")">@a.AdjustmentType</span></td>
                        <td class="text-center">@a.Quantity</td>
                        <td>@a.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
