@page "{id:guid}"
@model Octalines.Web.Pages.Suppliers.EditSupplierModel
@{ ViewData["Title"] = "Edit Supplier"; }
<div class="card" style="max-width:620px">
    <div class="card-header fw-semibold">Edit Supplier</div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-12"><label class="form-label">Name *</label><input asp-for="Input.Name" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Phone</label><input asp-for="Input.Phone" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Email</label><input asp-for="Input.Email" class="form-control" type="email" /></div>
                <div class="col-12"><label class="form-label">Address</label><textarea asp-for="Input.Address" class="form-control" rows="2"></textarea></div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Update</button>
                <a href="/Suppliers" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
