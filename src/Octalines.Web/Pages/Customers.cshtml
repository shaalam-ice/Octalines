@page
@model Octalines.Web.Pages.CustomersModel
@{
    ViewData["Title"] = "Customers";
}
<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <input name="filter" type="text" class="form-control form-control-sm" placeholder="Search name/phone..." value="@Model.Filter" style="width:220px" />
        <button type="submit" class="btn btn-sm btn-outline-primary">Search</button>
    </form>
    <a href="/Customers/Create" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>Add Customer</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Phone</th><th>Email</th><th>Balance</th><th>Status</th><th style="width:100px"></th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers?.Items ?? Array.Empty<ContactDto>())
                {
                    <tr>
                        <td class="fw-semibold">@c.Name</td>
                        <td>@c.Phone</td>
                        <td>@c.Email</td>
                        <td>@c.Balance.ToString("N2")</td>
                        <td><span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <a href="/Customers/Edit/@c.Id" class="btn btn-xs btn-sm btn-outline-secondary py-0 px-2">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if ((Model.Customers?.TotalCount ?? 0) > 0)
{
    <div class="mt-2 text-muted small">Showing @(Model.Customers?.Items.Count ?? 0) of @Model.Customers?.TotalCount records</div>
}
