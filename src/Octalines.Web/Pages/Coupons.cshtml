@page
@model Octalines.Web.Pages.CouponsModel
@{
    ViewData["Title"] = "Coupons";
}
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" href="/Coupons">Global Coupons</a></li>
    <li class="nav-item"><a class="nav-link" href="/Coupons/Customer">Customer Coupons</a></li>
</ul>
<div class="d-flex justify-content-end mb-3">
    <a href="/Coupons/Create" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>New Coupon</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Code</th><th>Discount</th><th>Usage</th><th>Expiry</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Coupons?.Items ?? Array.Empty<CouponDto>())
                {
                    <tr>
                        <td><code class="fw-bold">@c.Code</code></td>
                        <td>@(c.IsPercentage ? c.DiscountPercent + "%" : c.DiscountAmount.ToString("N2"))</td>
                        <td>@c.UsedCount / @(c.MaxUses?.ToString() ?? "∞")</td>
                        <td>@(c.ExpiryDate?.ToString("dd MMM yy") ?? "Never")</td>
                        <td><span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Active" : "Inactive")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
