<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>POS - Octalines</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        html, body { height: 100%; margin: 0; background: #f0f2f5; overflow: hidden; }
        .pos-container { height: 100vh; display: flex; flex-direction: column; }
        .pos-header { background: #1a1a2e; color: #fff; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
        .pos-body { flex: 1; overflow: hidden; padding: 16px; display: flex; gap: 16px; min-height: 0; }
        .card { border: none; box-shadow: 0 1px 4px rgba(0,0,0,0.07); border-radius: 8px; }
    </style>
</head>
<body>
<div class="pos-container">
    <div class="pos-header">
        <strong><i class="fas fa-cash-register me-2"></i>Point of Sale</strong>
        <a href="/Sales" class="btn btn-sm btn-outline-light"><i class="fas fa-times me-1"></i>Exit POS</a>
    </div>
    <div class="pos-body">
        @RenderBody()
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
